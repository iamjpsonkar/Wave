{
  "name": "wave",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config config/vite.config.ts",
    "build": "tsc -b && vite build --config config/vite.config.ts",
    "preview": "vite preview --config config/vite.config.ts",
    "typecheck": "tsc -b --pretty",
    "test": "node --experimental-strip-types --test tests/*.test.js",
    "test:e2e": "playwright test --config config/playwright.config.ts",
    "docker:build": "docker build -t wave:local .",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "test:local": "bash ./test.sh"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "remark-gfm": "^4.0.0",
    "rehype-sanitize": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "typescript": "~5.7.2",
    "vite": "^6.0.7"
  }
}
