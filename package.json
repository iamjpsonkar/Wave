{
  "name": "wave",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config config/vite.config.ts",
    "build": "tsc -b && vite build --config config/vite.config.ts",
    "preview": "vite preview --config config/vite.config.ts",
    "typecheck": "tsc -b --pretty",
    "test": "node --experimental-strip-types --test",
    "test:e2e": "playwright test --config config/playwright.config.ts",
    "docker:build": "docker build -t wave:local .",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "test:local": "bash ./test.sh",
    "test:unit": "node --experimental-strip-types --test",
    "test:unit:storage": "node --experimental-strip-types --test tests/unit/storage/*.test.js",
    "test:unit:diagnostics": "node --experimental-strip-types --test tests/unit/diagnostics/*.test.js",
    "test:unit:safety": "node --experimental-strip-types --test tests/unit/safety/*.test.js",
    "license:audit": "node scripts/check-dependency-licenses.mjs",
    "license:audit:json": "node scripts/check-dependency-licenses.mjs --json",
    "test:license": "npm run license:audit",
    "license:audit:update": "node scripts/check-dependency-licenses.mjs --update-inventory"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.0",
    "rehype-sanitize": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.8"
  },
  "license": "MIT"
}
